# Copy this file to .env locally. Never commit .env.

# Public app identity.
APP_NAME=Brain Clash
# Required for Farcaster/Base Mini App publishing. Must be HTTPS in production.
APP_URL=https://your-domain.example

# Farcaster manifest ownership proof.
# Generate these after the app is deployed and accessible at APP_URL.
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=
# Optional: use this instead if Farcaster gives you a hosted manifest id.
FARCASTER_HOSTED_MANIFEST_ID=
# Keep true/implicit while testing Base Sepolia. Set false only for production discovery.
FARCASTER_NOINDEX=true

# Local/dev helpers. Do not enable DEV_MODE in production.
DEV_MODE=false
MATH_CLASH_STATE_FILE=

# Optional future persistent production database.
# If absent, the app uses local JSON storage.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Base Build ownership metadata.
BASE_BUILDER_OWNER_ADDRESS=

# Hardhat deployer for Base Sepolia only.
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contract constructor values.
RESOLVER_ADDRESS=
FEE_RECIPIENT_ADDRESS=

# Testnet token support.
# Official Circle USDC on Base Sepolia:
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Optional: put your own Base Sepolia mock/test USDT address here.
BASE_SEPOLIA_USDT_ADDRESS=

# server.js payout resolver settings for Base Sepolia testing.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
ESCROW_CONTRACT_ADDRESS=
ESCROW_RESOLVER_PRIVATE_KEY=
SETTLEMENT_ADMIN_TOKEN=

PORT=4173
