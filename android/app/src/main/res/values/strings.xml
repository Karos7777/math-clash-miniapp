    <!-- Rules -->
    <string name="rules_title">How to play</string>
    <string name="rules_goal_title">The goal</string>
    <string name="rules_goal_body">Put every number from the tray into the grid so that all row equations and all column equations come out to the number printed at their end. Each number is used exactly once.</string>
    <string name="rules_cross_title">Why it is hard</string>
    <string name="rules_cross_body">Every cell answers to two equations at once — the row it sits in and the column it sits in. A number that fixes a row usually breaks a column, so you have to hold several lines in your head at the same time.</string>
    <string name="rules_order_title">Order of operations</string>
    <string name="rules_order_standard">× and ÷ are worked out before + and −, the usual school rule. 2 + 3 × 4 = 14.</string>
    <string name="rules_order_ltr">Lines are read strictly left to right, and top to bottom. 2 + 3 × 4 = 20.</string>
    <string name="rules_order_switch">You can switch this in Settings.</string>
    <string name="rules_controls_title">Controls</string>
    <string name="rules_controls_body">Tap an empty cell, then tap a number to drop it in. Tap a number already on the board to take it back. Amber cells are given to you and cannot be moved. A line turns green the moment it is right and red when it is finished but wrong.</string>
    <string name="rules_train_title">What it trains</string>
    <string name="rules_train_body">Mental arithmetic under a clock, plus holding several constraints in working memory at once. Short focused sets work better than long sessions — a five board run is enough to feel switched on.</string>
